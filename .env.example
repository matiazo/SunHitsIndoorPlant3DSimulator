# Home Assistant API Configuration
# =================================
# 
# Get a Long-Lived Access Token from Home Assistant:
# 1. Go to your Profile (click your name in sidebar)
# 2. Scroll down to "Long-Lived Access Tokens"
# 3. Click "Create Token" and give it a name
# 4. Copy the token and paste it below
#
# WARNING: Keep this file secure and don't commit to version control!

# Home Assistant URL (change if needed)
HA_URL=http://dell7050:8123

# Long-Lived Access Token (REQUIRED - paste your token here)
HA_TOKEN=
